# ──────────────────────────────────────────────────
# 黄金配置 Agent — 环境变量示例
# 复制为 .env 并填入真实值
# ──────────────────────────────────────────────────

# Anthropic API Key
# 在 https://console.anthropic.com/settings/keys 获取
ANTHROPIC_API_KEY=sk-ant-...

# 飞书自定义机器人 Webhook
# 飞书群 → 设置 → 机器人 → 添加自定义机器人 → 复制 Webhook 地址
FEISHU_WEBHOOK_URL=https://open.feishu.cn/open-apis/bot/v2/hook/xxxxxxxx

# 飞书机器人签名（可选，开启「签名校验」时填写）
# FEISHU_SECRET=your_secret_here
