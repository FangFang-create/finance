# ──────────────────────────────────────────────────────────────────────────────
# 黄金配置 Agent — 环境变量示例
# 复制为 .env 并填入真实值
# ──────────────────────────────────────────────────────────────────────────────

# Anthropic API Key
# https://console.anthropic.com/settings/keys
ANTHROPIC_API_KEY=sk-ant-...

# ── 定时推送（飞书自定义机器人 Webhook）──────────────────────────────────────
# 飞书群 → 设置 → 机器人 → 添加自定义机器人 → 复制 Webhook 地址
FEISHU_WEBHOOK_URL=https://open.feishu.cn/open-apis/bot/v2/hook/xxxxxxxx
# 开启签名校验时填写（可选）
# FEISHU_SECRET=your_secret_here

# ── 实时对话（飞书应用机器人）────────────────────────────────────────────────
# 飞书开放平台 https://open.feishu.cn/app → 创建企业自建应用
# → 凭证与基础信息 → 复制 App ID 和 App Secret
FEISHU_APP_ID=cli_...
FEISHU_APP_SECRET=...

# Web 服务端口（默认 8000）
# PORT=8000
